# ==============================================================================
# Empório da Música — AI Customer Support Agent Configuration
# ==============================================================================

# Choose LLM Provider: "groq", "ollama", "openai", "gemini", or "offline"
# Default "auto" automatically detects available API keys (Groq -> OpenAI -> Gemini -> Ollama -> Offline Engine)
LLM_PROVIDER=auto

# Groq API Configuration (Recommended Free Tier - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama Configuration (http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Optional: OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: Google Gemini API Configuration (OpenAI-compatible endpoint)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Simulated Reference Date for Order & Return Policy Calculations (YYYY-MM-DD)
# Since the dataset orders span Oct 2025 – Mar 2026, setting a reference date
# allows deterministic testing of 7-day regret and 30-day defect windows.
REFERENCE_DATE=2026-03-23
